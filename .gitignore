# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.pnp.js

# yarn 4 (Berry) — commit releases/plugins/patches, ignore cache/state
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# vite
/dist/

# production
/build
**/dist/

# tauri + rust build artifacts
**/src-tauri/target/
**/relay/target/
**/target/

# misc
.DS_Store
.directory
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite runtime data (self-host)
/data/
*.db
*.db-journal
src-tauri/binaries/

# Security audits — describe live attack surface, kept local-only.
# Never commit until the corresponding fixes have shipped.
SecurityAudits/
