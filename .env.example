# Void Chat — self-host config
# Copy this file to `.env` and adjust as needed. Defaults work out of the
# box for `docker compose up` or `yarn dev` + `yarn socket` on localhost.

# =============================================================================
# DATABASE
# SQLite file path. Default lives in ./data so it persists outside the build.
# Back up your server by copying this file.
# =============================================================================
# Path is resolved relative to prisma/schema.prisma, so `../data/...` lands
# the SQLite file at the repo root in /data/. Adjust if your deploy mounts
# the data volume elsewhere.
DATABASE_URL="file:../data/voidchat.db"

# =============================================================================
# RELAY (socket server)
# Port the relay listens on. The Next app derives the relay URL from the
# browser's location.host, so this only matters if you change the port.
# =============================================================================
SOCKET_PORT=3001

# Comma-separated list of origins the relay will accept WebSocket
# connections from. For local/LAN use, leave this as-is. For an internet
# deployment, set to the URL your Next app is served from.
CORS_ORIGIN="http://localhost:3000"

# OPTIONAL: override the relay URL the client connects to. Leave empty to
# default to same-origin + port 3001 (correct for almost all setups). Only
# set this if you proxy the relay through a different host or path.
# Example: "wss://relay.alice.tld"
NEXT_PUBLIC_VOID_RELAY_URL=""

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV="production"
