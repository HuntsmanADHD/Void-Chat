# =============================================================================
# DATABASE
# WARNING: Do NOT use localhost in production. Set your actual database host.
# =============================================================================
DATABASE_URL="postgresql://user:password@YOUR_DB_HOST:5432/voidchat_db?connection_limit=20&pool_timeout=10"

# =============================================================================
# AUTHENTICATION & SECURITY
# WARNING: Use a strong random secret (min 32 chars). Do NOT use default values.
# =============================================================================
AUTH_TOKEN_SECRET="CHANGE_ME_use_a_strong_random_secret_min_32_chars"

# =============================================================================
# CORS / ALLOWED ORIGINS
# WARNING: Set to your actual production domain(s), comma-separated.
# =============================================================================
ALLOWED_ORIGINS="https://YOUR_PRODUCTION_DOMAIN"

# =============================================================================
# SOCKET SERVER
# WARNING: Set CORS_ORIGIN and NEXT_PUBLIC_SOCKET_URL to your production URLs.
# =============================================================================
SOCKET_PORT=3001
CORS_ORIGIN="https://YOUR_PRODUCTION_DOMAIN"
NEXT_PUBLIC_SOCKET_URL="https://YOUR_PRODUCTION_SOCKET_URL"

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV="production"
