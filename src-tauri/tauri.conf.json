{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Void Chat",
  "version": "0.1.0",
  "identifier": "dev.voidchat.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn dev:all",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Void Chat",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/tor-runtime"
    ],
    "shortDescription": "Privacy-first desktop messenger over Tor hidden services",
    "longDescription": "Void Chat routes everything through Tor hidden services. Run it locally; your friends reach you at a .onion address. No accounts, no email, no message history. Ephemeral identities per browser tab.",
    "copyright": "© 2026 HuntsmanADHD. MIT licensed. Bundled Tor © The Tor Project (https://www.torproject.org).",
    "category": "SocialNetworking",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
