generator client {
  provider = "prisma-client-js"
}

// SQLite chosen for the self-host model: zero-config, single file lives
// next to the binary, trivial to back up (copy the .db file). The schema
// only holds the community/channel directory — no message data, no users.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  avatar      String?
  createdAt   DateTime @default(now())

  channels Channel[]

  @@index([name])
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  communityId String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, name])
  @@index([communityId])
}
