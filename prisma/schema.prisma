generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReportCategory {
  SPAM
  HARASSMENT
  SCAM
  ILLEGAL
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ScanStatus {
  PENDING
  SCANNING
  CLEAN
  QUARANTINED
  ERROR
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  DM_RECEIVED
  MENTION
  REACTION
  COMMUNITY_INVITE
  STRIKE_RECEIVED
  APPEAL_UPDATE
  REPLY_RECEIVED
}

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  xHandle       String?   @unique
  xId           String?   @unique
  publicKey     String
  tokenBalance  BigInt    @default(0)
  strikes       Int       @default(0)
  isBlacklisted Boolean   @default(false)
  blacklistedAt DateTime?
  timeoutUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedCommunities Community[]  @relation("CommunityOwner")
  memberships      Membership[]
  sentMessages     Message[]    @relation("MessageSender")
  receivedMessages Message[]    @relation("MessageRecipient")
  reportsFiled     Report[]     @relation("Reporter")
  reportsReceived  Report[]     @relation("ReportedUser")
  strikes_received Strike[]     @relation("StrikeUser")
  reviewedReports  Report[]     @relation("ReportReviewer")
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  appealsSubmitted Appeal[]     @relation("AppealUser")
  appealsReviewed  Appeal[]     @relation("AppealReviewer")
  reactions        Reaction[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")

  @@index([walletAddress])
  @@index([isBlacklisted])
}

model Community {
  id              String   @id @default(cuid())
  name            String
  description     String?
  avatar          String?
  ownerId         String
  minTokenBalance BigInt   @default(0)
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner       User         @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  channels    Channel[]
  memberships Membership[]

  @@index([ownerId])
  @@index([isPublic])
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  communityId String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([communityId])
}

model Message {
  id               String   @id @default(cuid())
  encryptedContent String
  nonce            String
  senderId         String
  channelId        String?
  recipientId      String?
  isDirectMessage  Boolean  @default(false)
  createdAt        DateTime @default(now())
  parentId         String?
  replyCount       Int      @default(0)

  sender      User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  recipient   User?        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reports     Report[]
  attachments Attachment[]
  reactions   Reaction[]
  parent      Message?     @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Message[]    @relation("MessageReplies")

  @@index([senderId])
  @@index([channelId])
  @@index([recipientId])
  @@index([createdAt])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  communityId String
  role        MembershipRole @default(MEMBER)
  joinedAt    DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  messageId      String?
  category       ReportCategory
  description    String
  status         ReportStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime     @default(now())

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reviewedBy   User?    @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  strike       Strike?

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model Strike {
  id           String    @id @default(cuid())
  userId       String
  reportId     String    @unique
  strikeNumber Int
  reason       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  user   User    @relation("StrikeUser", fields: [userId], references: [id], onDelete: Cascade)
  report Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appeal Appeal?

  @@index([userId])
}

model Appeal {
  id           String       @id @default(cuid())
  strikeId     String       @unique
  userId       String
  reason       String
  status       AppealStatus @default(PENDING)
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?

  strike     Strike @relation(fields: [strikeId], references: [id], onDelete: Cascade)
  user       User   @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Attachment {
  id              String     @id @default(cuid())
  messageId       String?
  uploaderId      String
  fileName        String
  fileType        String
  fileSize        Int
  fileExtension   String
  storagePath     String
  encryptionNonce String
  scanStatus      ScanStatus @default(PENDING)
  scanResult      Json?
  scannedAt       DateTime?
  quarantineReason String?
  thumbnailPath   String?
  thumbnailNonce  String?
  createdAt       DateTime   @default(now())

  message         Message?   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader        User       @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
  @@index([scanStatus])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String?
  read        Boolean          @default(false)
  messageId   String?
  channelId   String?
  communityId String?
  senderId    String?
  createdAt   DateTime         @default(now())

  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
