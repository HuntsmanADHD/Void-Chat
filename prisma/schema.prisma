generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ephemeral identity model: server holds room structure only.
// No users, no memberships, no moderation tables. Sessions live in client
// memory; community membership is implicit (you're "in" a room as long as
// your socket is connected to its channel).

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  avatar      String?
  createdAt   DateTime @default(now())

  channels Channel[]

  @@index([name])
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  communityId String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, name])
  @@index([communityId])
}
